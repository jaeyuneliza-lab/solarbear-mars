# .env.example 을 복사해 .env 로 이름을 바꾸고 아래 값을 채우세요. .env 는 절대 공유·커밋하지 마세요.

# Upstage 콘솔(console.upstage.ai) → API Keys 에서 발급한 키. 비워 두면 mock 모드(저장된 #22 결과 재생)로 동작합니다.
UPSTAGE_API_KEY=

# 실행할 Studio 워크플로와 설정 (현재 값 = 세팅 #22)
STUDIO_AGENT_ID=agt_FrfTdFmra9xf9j8GgAp6AH
STUDIO_CONFIG_ID=cfg_3tnXM8PPYfvAutuYiGoLrE
STUDIO_CONFIG_LABEL=#22

# 선택: 판정이 나올 때마다 알림을 보낼 웹훅 주소 (Slack·Discord 등 {"text": ...} 를 받는 곳)
NOTIFY_WEBHOOK_URL=

# 선택: 키가 있어도 mock 으로 돌리고 싶으면 1
MOCK=
PORT=8770
